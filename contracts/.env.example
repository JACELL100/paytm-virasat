# Copy to `.env` and fill in real values. Never commit the real `.env`.

# Alchemy (or another) Sepolia RPC endpoint.
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/<key>

# Deployer key: separate from the backend's relayer key. Only needs enough
# SepoliaETH to deploy + run the setup calls (setCredential/setRelayer).
# After deploying, consider registry.transferOwnership(<cold key>).
DEPLOYER_PRIVATE_KEY=0x...

# The relayer address the backend will submit transactions from (see
# backend/.env's RELAYER_PRIVATE_KEY -- this is that key's public address).
# Wired into VirasatRegistry.setRelayer(...) and ClaimLedger's constructor
# during scripts/deploy.py.
RELAYER_ADDRESS=0x...

# Etherscan API V2 key, for scripts/verify_etherscan.py (optional).
ETHERSCAN_API_KEY=...

# Floor (seconds) for inactivityPeriod/challengePeriod on VirasatRegistry.
# 60 for the hackathon demo (Demo Mode time-warp); use something like
# 2592000 (30 days) in production.
MIN_PERIOD=60
